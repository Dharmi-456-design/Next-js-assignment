# =============================================================================
# ReserveX — Next.js / TypeScript / Tailwind CSS / MongoDB
# Professional .gitignore
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Artifacts ──────────────────────────────────────────────────
/.next/
/out/
/build
/dist

# ── TypeScript Build Cache ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment Variables ─────────────────────────────────────────────────────
# DO NOT commit real env files. Keep .env.example for reference.
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
# Preserve the example template:
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ────────────────────────────────────────────────────────
/coverage
/.nyc_output

# ── Deployment / CDN Caches ───────────────────────────────────────────────────
.vercel
.turbo
.cache

# ── OS Artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
Desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── Miscellaneous ─────────────────────────────────────────────────────────────
# Local scripts that may contain sensitive data
/scripts/local-*

# ── Never ignore these ────────────────────────────────────────────────────────
!README.md
!.env.example
!.gitignore
